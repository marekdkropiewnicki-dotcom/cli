{
  "servers": {
    "github": {
      "type": "sse",
      "url": "https://mcp.github.com/mcp"
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "brave-search": {
      "type": "sse",
      "url": "https://server.smithery.ai/@arjunkmrm/brave-search-mcp-server/mcp",
      "headers": {
        "Authorization": "Bearer ${{ secrets.SMITHERY_API_KEY }}"
      }
    },
    "telegram": {
      "type": "stdio",
      "command": "mcp-telegram",
      "env": {
        "TELEGRAM_API_ID": "${{ secrets.TELEGRAM_API_ID }}",
        "TELEGRAM_API_HASH": "${{ secrets.TELEGRAM_API_HASH }}"
      }
    },
    "discord": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@scarecr0w12/discord-mcp"],
      "env": {
        "DISCORD_BOT_TOKEN": "${{ secrets.DISCORD_BOT_TOKEN }}"
      }
    },
    "huggingface": {
      "type": "sse",
      "url": "https://hf.co/mcp/sse",
      "headers": {
        "Authorization": "Bearer ${{ secrets.HUGGINGFACE_API_KEY }}"
      }
    }
  }
}